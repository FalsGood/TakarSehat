# Variabel lingkungan — salin file ini menjadi .env dan isi nilainya

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/takarsehat?schema=public"

# ─── NextAuth.js ───────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-secret-yang-kuat"
NEXTAUTH_URL="http://localhost:3000"

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="TakarSehat"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
